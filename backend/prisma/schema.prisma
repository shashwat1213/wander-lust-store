generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  addresses     Address[]
  orders        Order[]
  wishlistItems WishlistItem[]
}

enum Role {
  ADMIN
  CUSTOMER
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  street    String
  city      String
  state     String
  postalCode String
  country   String
  isDefault Boolean  @default(false)
}

// Product Catalog
model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category? @relation("Categories", fields: [parentId], references: [id])
  children    Category[] @relation("Categories")
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  shortDescription String?
  price       Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  sku         String   @unique
  stock       Int      @default(0)
  trackQuantity Boolean @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  url       String
  altText   String?
  position  Int      @default(0)
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String   // e.g., "Size", "Color"
  value     String   // e.g., "Large", "Red"
  sku       String   @unique
  priceAdjustment Decimal @db.Decimal(10, 2) @default(0)
  stock     Int      @default(0)
  orderItems OrderItem[]
}

// Orders & Cart
model Order {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  subtotal      Decimal  @db.Decimal(10, 2)
  taxAmount     Decimal  @db.Decimal(10, 2)
  shippingAmount Decimal @db.Decimal(10, 2)
  discountAmount Decimal @db.Decimal(10, 2)
  totalAmount   Decimal  @db.Decimal(10, 2)
  shippingAddressId String
  shippingAddress ShippingAddress @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String
  billingAddress  ShippingAddress @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  items         OrderItem[]
  paymentId     String?   // Payment gateway transaction ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?   // Reference to selected variant
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  name        String   // Denormalized for historical accuracy
  sku         String
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
}

model ShippingAddress {
  id        String   @id @default(uuid())
  street    String
  city      String
  state     String
  postalCode String
  country   String
  phone     String?
  shippingOrders Order[] @relation("OrderShippingAddress")
  billingOrders  Order[] @relation("OrderBillingAddress")
}

// Wishlist
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  addedAt   DateTime @default(now())
}

// Discounts & Coupons
model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discountType DiscountType
  discountValue Decimal @db.Decimal(5, 2) // Percentage or fixed amount
  minPurchase Decimal? @db.Decimal(10, 2)
  usageLimit  Int?     // Null = unlimited
  usedCount   Int      @default(0)
  startsAt    DateTime
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}
